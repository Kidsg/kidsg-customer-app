# ==============================================================================
# BookBuddys Hyperlocal Commerce Platform — Backend Environment Configuration
# Safe template. Never commit real credentials or production keys.
# ==============================================================================

NODE_ENV=development
APP_ENV=DEV
PORT=3000
API_BASE_URL=http://localhost:3000

# Supabase PostgreSQL & Storage Configuration
SUPABASE_URL=https://ogglmiewsswgkyjajnrg.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY

# Operational Brand & Founder Contact
BRAND_NAME=BookBuddys
FOUNDER_EMAIL=founder@bookbuddys.in
FOUNDER_NOTIF_PHONE=+919876543210
MERCHANT_UPI_ID=bookbuddys@upi

# Notification & Email Provider
EMAIL_PROVIDER=resend
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=orders@bookbuddys.in
RESEND_FROM_NAME=BookBuddys Bengaluru

# OTP Authentication Provider (supabase | mock)
OTP_PROVIDER=supabase

# Payment Gateway Configuration (manual_upi | razorpay | mock)
PAYMENT_PROVIDER=manual_upi
RAZORPAY_KEY_ID=YOUR_RAZORPAY_KEY_ID
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_KEY_SECRET
RAZORPAY_WEBHOOK_SECRET=YOUR_RAZORPAY_WEBHOOK_SECRET

# Hyperlocal Delivery Providers (manual | porter | rapido | mock)
DELIVERY_PROVIDER=manual
PORTER_API_KEY=YOUR_PORTER_ENTERPRISE_API_KEY
RAPIDO_API_KEY=YOUR_RAPIDO_CLIENT_API_KEY

# Geospatial & Maps Provider (nominatim | google | mapbox | mock)
MAPS_PROVIDER=nominatim
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Pricing & Delivery Fee Rules
FREE_DELIVERY_THRESHOLD=499
DEFAULT_DELIVERY_FEE=30
MINIMUM_ORDER_VALUE=0

# Session & JWT Secret
JWT_SECRET=GENERATE_SECURE_RANDOM_SECRET_KEY
